# cumulative boot ledger + soak reports (runtime data, accrues on disk)
boot-ledger.jsonl
boot-ledger.txt
soak-*
!soak.py
# `soak-*` matches at every level, so it swallowed docs/soak-and-breakglass.md
# (the harness documentation) as if it were a runtime report. Un-ignore it.
!docs/soak-and-breakglass.md

# v1-gate long-run harness state (soak72.py / breakglass_cycle.py). Append-only
# event logs and resumable state files: runtime data, never committed.
soak72-state.json
soak72-events.jsonl
soak72-logs/
breakglass-state.json
breakglass-events.jsonl
breakglass-logs/
soak-logs/
soak*.log
soak*-report.json
soak*-report.txt
test_vgic_pendq
test_vgicd
test_coredump_elf
test_sd_bio_addr
test_snapshot_fmt
test_bmc_arm_gate
.flagstamp
# Runtime evidence directories: per-run logs and captured crash artefacts. They
# accrue on disk during live board work and are not part of the source tree, for
# the same reason the soak/breakglass logs above are not.
a2-logs/
crash-evidence/
backups/
# `bzdctl.py crash` writes timestamped bundles as crash-<YYYYMMDD-HHMMSS>/, which
# the crash-evidence/ line above never actually matched -- so they were piling up
# untracked and unignored. Ignore the raw dumps, but keep the hand-written
# analysis that cites them: a finding.md is the part worth reading in a year,
# and the numbers it quotes are in the text.
crash-2*/
!crash-2*/finding.md

# Host-side unit-test binaries built by `make test` -- same class as the ones
# already listed above, missed when this one was added.
test_scanout_regs
test_vconsole_pm
test_zstage

# Generated by gen_config.py from board-config.xml — never hand-edited,
# never committed (the Makefile says so in its own header comment).
config.mk
