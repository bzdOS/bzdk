[Unit]
# Persistent board supervisor for the bzdOS Chimp board (Banana Pi M64).
#
# Why a unit and not a nohup: chimpd is the recovery path of last resort --
# it catches the U-Boot prompt over USB-ACM and reloads the hypervisor when
# the board cannot recover itself. Run from a shell it dies with the session,
# and on 2026-09-23 that is exactly what happened: it was stopped for a
# measurement, nothing restarted it, and the board was left with no net.
Description=bzdOS Chimp board supervisor (chimpd)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/bzdos/microkernel
ExecStart=/usr/bin/python3 -u /opt/bzdos/microkernel/chimpd.py
# Board work is long and bursty; never let systemd decide it is hung.
TimeoutStopSec=30
Restart=always
RestartSec=10
StandardOutput=append:/var/log/chimpd.log
StandardError=append:/var/log/chimpd.log

[Install]
WantedBy=multi-user.target
